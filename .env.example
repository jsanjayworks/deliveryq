# Copy this file to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL ---
POSTGRES_USER=deliveriq
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=deliveriq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role used by the NL->SQL /ask endpoint (safety: LLM-generated SQL
# runs only through this role, which cannot write).
POSTGRES_READONLY_USER=deliveriq_ro
POSTGRES_READONLY_PASSWORD=change_me_locally_too

# --- LLM provider ---
# Set whichever provider you use. The /ask and feedback-classification features need this.
LLM_API_KEY=
LLM_MODEL=
